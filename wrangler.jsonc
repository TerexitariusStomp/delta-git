{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "git-on-cloudflare",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-05-13",
  "compatibility_flags": [
    "nodejs_als"
  ],
  "workers_dev": true,
  // Free plan: custom cpu_ms limits need Workers Paid (default 30s cap).
  "durable_objects": {
    "bindings": [
      {
        "name": "REPO_DO",
        "class_name": "RepoDurableObject"
      },
      {
        "name": "ADJUDICATOR_DO",
        "class_name": "AdjudicatorAgent"
      },
      {
        "name": "REPO_AGENT_DO",
        "class_name": "RepoAgent"
      },
      {
        "name": "FIREHOSE_DO",
        "class_name": "FirehoseAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RepoDurableObject"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "AuthDurableObject"
      ]
    },
    {
      "tag": "v3",
      "deleted_classes": [
        "AuthDurableObject"
      ]
    },
    {
      "tag": "v4",
      // SQLite-backed so the agent DOs deploy on the free plan (KV-backed
      // new_classes is paid-only); the KV-style storage API works unchanged.
      "new_sqlite_classes": [
        "AdjudicatorAgent",
        "RepoAgent",
        "FirehoseAgent"
      ]
    }
  ],
  "kv_namespaces": [
    {
      "binding": "ROUTES",
      "id": "947d755b199a45b7bf85c0ddfbe31fac"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "git-on-cloudflare",
      "database_id": "651a76f1-4a63-4cc6-9b2d-90e97e5b02a1",
      "migrations_dir": "drizzle/d1"
    }
  ],
  "r2_buckets": [
    {
      "binding": "REPO_BUCKET",
      "bucket_name": "git-repos"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  // Analytics Engine needs a one-time dashboard opt-in per account
  // (dash.cloudflare.com/<acct>/workers/analytics-engine). Re-enable this
  // binding once opted in — `metric()` no-ops while it's absent.
  // "analytics_engine_datasets": [
  //   {
  //     "binding": "ANALYTICS",
  //     "dataset": "dg_metrics"
  //   }
  // ],
  "queues": {
    "producers": [
      {
        "binding": "REPO_TASKS_QUEUE",
        "queue": "git-on-cloudflare-repo-maint"
      }
    ],
    "consumers": [
      {
        "queue": "git-on-cloudflare-repo-maint",
        "max_batch_size": 1,
        "max_batch_timeout": 1
      }
    ]
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/client",
    "html_handling": "none"
  },
  // Environment variables (text/JSON)
  "vars": {
    // Repo DO idle cleanup threshold (minutes)
    "REPO_DO_IDLE_MINUTES": "30",
    // Logging level: debug|info|warn|error
    "LOG_LEVEL": "info",
    // tessera OIDC issuer (production). Override via .dev.vars for local dev.
    // Client id and secret are runtime concerns and live in .dev.vars / `wrangler secret put`.
    "TESSERA_OIDC_ISSUER": "https://auth.limic.dev",
    // atproto DID sign-in is the primary web identity; tessera stays wired
    // in code but disabled. Set to "on" to re-enable the OIDC login path.
    "TESSERA_AUTH": "off",
    // atproto PDS/base URL used for DID+handle resolution
    // (com.atproto.identity.resolveDid / resolveHandle).
    "ATP_PDS_URL": "https://bsky.social",
    // Hermes browser-agent deployment origin (embed.js source for /embed/hermes).
    "HERMES_ORIGIN": "https://hermes.widespread.fyi"
  }
}
