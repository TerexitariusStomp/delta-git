{
  "name": "git-on-cloudflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run db:migrate && npm run build && wrangler deploy",
    "test": "vitest run --config vitest.unit.config.ts",
    "test:workers": "vitest run --config vitest.config.ts",
    "test:auth": "vitest run --config vitest.config.ts test/auth.worker.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "types:generate": "wrangler types --env-file .dev.vars.example",
    "typecheck": "npm run types:generate && tsc -p test/tsconfig.json --noEmit",
    "cf-typegen": "npm run types:generate",
    "db:generate:repo": "drizzle-kit generate --config drizzle-repo-do.config.ts",
    "db:generate:d1": "drizzle-kit generate --config drizzle-d1.config.ts",
    "db:generate": "npm run db:generate:repo && npm run db:generate:d1",
    "db:migrate": "wrangler d1 migrations apply git-on-cloudflare --remote",
    "db:migrate:local": "wrangler d1 migrations apply git-on-cloudflare --local"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.36.4",
    "@cloudflare/vitest-pool-workers": "^0.16.4",
    "@tailwindcss/vite": "^4.3.0",
    "@types/diff": "^7.0.2",
    "@types/mime": "^3.0.4",
    "@types/node": "^25.7.0",
    "@types/pako": "^2.0.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "drizzle-kit": "^0.31.4",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.7.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.12",
    "vitest": "^4.1.6",
    "wrangler": "4.140.0"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@octokit/openapi-types": "^29.0.1",
    "@primer/octicons-react": "19.38.0",
    "@primer/primitives": "11.10.0",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "deepmerge": "^4.3.1",
    "diff": "^9.0.0",
    "domhandler": "^6.0.1",
    "drizzle-orm": "^0.45.1",
    "highlight.js": "^11.11.1",
    "hono": "^4.13.9",
    "htmlparser2": "^12.0.0",
    "lucide-react": "^1.7.0",
    "marked": "^18.0.3",
    "mime": "^4.1.0",
    "node-diff3": "^3.2.1",
    "openid-client": "^6.8.4",
    "p-limit": "^7.3.3",
    "pako": "^2.1.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "standardwebhooks": "^1.1.1",
    "zod": "^4.4.3"
  }
}
